# Copy to backend/.env for local use. Replace every placeholder; never commit secrets.
DATABASE_URL=postgresql+psycopg://postgres:your-password@localhost:5432/mira
SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
MIRA_MODEL_SERVER_URL=http://127.0.0.1:8001
MIRA_API_KEY=replace-with-the-same-key-used-by-the-model-server
SEED_DEMO_USERS=true
